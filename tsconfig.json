{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2019", "dom"],
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "build",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.json", "test/**/*.ts"],
  "ts-node": {
    "esm": true,
    "logError": true
  }
}
